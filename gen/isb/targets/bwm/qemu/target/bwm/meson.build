# Build entries of target/bwm.
# Generated by repsynth.gen.isb.gen_qemu 0.3.0 from spec/reps/machine/bwm.yaml (family sha256 82b5aab4b4799de5). Do not edit.
gen = [
  decodetree.process('insn.decode', extra_args: [ '--decode', 'decode_insn' ])
]

bwm_ss = ss.source_set()
bwm_system_ss = ss.source_set()

bwm_ss.add(gen)
bwm_ss.add(files(
  'cpu.c',
  'translate.c',
  'op_helper.c',
  'ref/bwm.c',
  'ref/binary_integer.c'))

target_arch += {'bwm': bwm_ss}
target_system_arch += {'bwm': bwm_system_ss}
