# Build entries of target/twm.
# Generated by repsynth.gen.isb.gen_qemu 0.3.0 from spec/reps/machine/twm.yaml (family sha256 82b5aab4b4799de5). Do not edit.
gen = [
  decodetree.process('insn.decode', extra_args: [ '--decode', 'decode_insn' ])
]

twm_ss = ss.source_set()
twm_system_ss = ss.source_set()

twm_ss.add(gen)
twm_ss.add(files(
  'cpu.c',
  'translate.c',
  'op_helper.c',
  'ref/twm.c',
  'ref/balanced_ternary.c'))

target_arch += {'twm': twm_ss}
target_system_arch += {'twm': twm_system_ss}
